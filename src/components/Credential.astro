---
/**
 * Hanging ID badge: swings on a lanyard (spring physics), can be dragged,
 * tilts in 3D under the cursor and flips on click to show an "API response".
 */
import { useTranslations, type Lang } from '../i18n/ui';
interface Props { lang: Lang; photo?: string }
const { lang, photo } = Astro.props;
const t = useTranslations(lang).credential;
const json: [string, string][] = [
  ['name', '"Lourdes Ibañez"'],
  ['role', '"Backend Developer"'],
  ['company', '"Seeker Parking"'],
  ['stack', '["PHP", "Laravel", "MySQL"]'],
  ['learning', '["Python", "ML"]'],
  ['studying', '"FI · UNLPam"'],
];
---
<div class="badge-rig relative mx-auto flex w-full max-w-[21rem] justify-center pt-24 lg:pt-0" data-badge-rig>
  <div class="badge-swing relative" data-badge-swing>
    <!-- lanyard + clip -->
    <div class="lanyard absolute bottom-[calc(100%-6px)] left-1/2 h-28 w-6 lg:h-[70vh] -translate-x-1/2 rounded-b-sm" aria-hidden="true"></div>
    <div class="absolute bottom-[calc(100%-14px)] left-1/2 z-10 h-9 w-12 -translate-x-1/2 rounded-md border border-ink/30 bg-gradient-to-b from-[#d9d4dc] to-[#9a95a0] shadow-md" aria-hidden="true">
      <div class="mx-auto mt-2 h-2 w-6 rounded-full bg-ink/40"></div>
    </div>

    <div class="badge-tilt transition-transform duration-200 ease-out" data-badge-tilt style="transform-style:preserve-3d">
      <button
        type="button"
        class="badge-card relative block aspect-[5/8] w-[17.5rem] cursor-grab touch-none select-none text-left active:cursor-grabbing sm:w-[19rem]"
        data-badge-card
        aria-label={t.flip}
        aria-pressed="false"
      >
        <!-- FRONT -->
        <span class="badge-face absolute inset-0 flex flex-col overflow-hidden rounded-[1.6rem] border border-ink/15 bg-paper shadow-[0_40px_70px_-30px_rgb(26_31_43/0.7)]">
          <span class="flex items-center justify-between bg-ink px-5 pb-4 pt-5 text-paper">
            <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-malva">{t.pass}</span>
            <span class="h-2 w-12 rounded-full bg-paper/20" aria-hidden="true"></span>
            <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-paper/60">2026</span>
          </span>
          <span class="relative mx-5 mt-5 block aspect-square overflow-hidden rounded-2xl bg-blush">
            {photo ? (
              <img src={photo} alt="Lourdes Ibañez" class="size-full object-cover" draggable="false" />
            ) : (
              <span class="dot-grid flex size-full items-center justify-center font-display text-[7rem] font-black leading-none text-malva-ink">LI</span>
            )}
            <span class="absolute right-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-paper/90 px-2.5 py-1 font-mono text-[0.6rem] uppercase tracking-wider text-ink">
              <span class="pulse-dot size-1.5 rounded-full bg-sage"></span>{t.status}
            </span>
          </span>
          <span class="mt-4 px-5 font-display text-[2.6rem] font-black uppercase leading-[0.85] tracking-tight text-ink">
            Lourdes<br /><span class="text-malva-ink">Ibañez</span>
          </span>
          <span class="mt-2 px-5 font-mono text-xs uppercase tracking-[0.14em] text-ink/70">Backend Developer</span>
          <span class="mt-auto flex items-end justify-between gap-4 border-t border-dashed border-ink/20 px-5 pb-5 pt-4">
            <span>
              <span class="block font-mono text-[0.6rem] uppercase tracking-[0.18em] text-ink/50">ID</span>
              <span class="block font-mono text-sm font-medium text-ink">LI-0x2A</span>
            </span>
            <span class="barcode block h-8 w-24 text-ink/80" aria-hidden="true"></span>
          </span>
          <span class="badge-shine pointer-events-none absolute inset-0" aria-hidden="true"></span>
        </span>

        <!-- BACK -->
        <span class="badge-face badge-back absolute inset-0 flex flex-col overflow-hidden rounded-[1.6rem] border border-paper/15 bg-ink p-5 text-paper shadow-[0_40px_70px_-30px_rgb(26_31_43/0.7)]">
          <span class="flex items-center justify-between">
            <span class="flex gap-1.5" aria-hidden="true">
              <span class="size-2.5 rounded-full bg-malva"></span>
              <span class="size-2.5 rounded-full bg-paper/30"></span>
              <span class="size-2.5 rounded-full bg-sage"></span>
            </span>
            <span class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-paper/50">GET /api/lourdes</span>
          </span>
          <span class="mt-5 block flex-1 rounded-2xl bg-paper/[0.06] p-4 font-mono text-[0.72rem] leading-relaxed">
            <span class="block text-sage">200 OK</span>
            <span class="block">{'{'}</span>
            {json.map(([k, v], i) => (
              <span class="block pl-3"><span class="text-malva">"{k}"</span>: <span class="text-blush">{v}</span>{i < json.length - 1 ? ',' : ''}</span>
            ))}
            <span class="block">{'}'}</span>
          </span>
          <span class="mt-4 font-mono text-[0.62rem] uppercase tracking-[0.16em] text-paper/50">{t.back}</span>
        </span>
      </button>
    </div>
  </div>
  <p class="pointer-events-none absolute -bottom-10 left-1/2 -translate-x-1/2 whitespace-nowrap font-mono text-[0.65rem] uppercase tracking-[0.18em] text-ink/45" aria-hidden="true">{t.hint}</p>
</div>

<script>
  const rig = document.querySelector<HTMLElement>('[data-badge-rig]');
  const swing = rig?.querySelector<HTMLElement>('[data-badge-swing]');
  const tilt = rig?.querySelector<HTMLElement>('[data-badge-tilt]');
  const card = rig?.querySelector<HTMLButtonElement>('[data-badge-card]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (rig && swing && tilt && card) {
    // Spring pendulum: angle in degrees
    let angle = reduce ? 0 : 18; // starts off-centre so it swings in on load
    let vel = 0;
    let dragging = false;
    let moved = false;
    let startX = 0;
    let startY = 0;
    let lastX = 0;
    const K = 0.045; // stiffness
    const DAMP = 0.94; // damping

    const pivot = () => {
      const r = swing.getBoundingClientRect();
      return { x: r.left + r.width / 2, y: r.top - 120 };
    };

    const frame = () => {
      if (!dragging) {
        vel += -angle * K;
        vel *= DAMP;
        angle += vel;
      }
      swing.style.transform = `rotate(${angle.toFixed(3)}deg)`;
      card.style.setProperty('--shine', `${50 + angle * 3}%`);
      requestAnimationFrame(frame);
    };
    if (!reduce) requestAnimationFrame(frame);

    card.addEventListener('pointerdown', (e) => {
      dragging = true;
      moved = false;
      startX = lastX = e.clientX;
      startY = e.clientY;
      card.setPointerCapture(e.pointerId);
    });
    card.addEventListener('pointermove', (e) => {
      // 3D tilt under the cursor
      const r = card.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width - 0.5;
      const py = (e.clientY - r.top) / r.height - 0.5;
      if (!reduce) tilt.style.transform = `rotateY(${px * 16}deg) rotateX(${-py * 12}deg)`;
      if (!dragging || reduce) return;
      if (Math.hypot(e.clientX - startX, e.clientY - startY) > 6) moved = true;
      const p = pivot();
      const target = (Math.atan2(e.clientX - p.x, Math.max(80, e.clientY - p.y)) * 180) / Math.PI;
      vel = (e.clientX - lastX) * 0.08;
      lastX = e.clientX;
      angle = Math.max(-45, Math.min(45, target));
    });
    const release = () => {
      dragging = false;
    };
    card.addEventListener('pointerup', release);
    card.addEventListener('pointercancel', release);
    card.addEventListener('pointerleave', () => {
      tilt.style.transform = '';
    });
    card.addEventListener('click', () => {
      if (moved) return;
      const flipped = card.classList.toggle('is-flipped');
      card.setAttribute('aria-pressed', String(flipped));
      vel += flipped ? 2.5 : -2.5; // a little nudge when flipping
    });
    // Nudge the badge when the pointer moves fast across the hero
    let px = 0;
    rig.closest('section')?.addEventListener('pointermove', (e) => {
      if (dragging || reduce) return;
      const dx = e.clientX - px;
      px = e.clientX;
      if (Math.abs(dx) < 60) vel += dx * 0.004;
    });
  }
</script>
