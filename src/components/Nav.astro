---
import Icon from './Icon.astro';
import { alternatePath, routes, useTranslations, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const home = routes.home(lang);
const isHome = Astro.url.pathname === home || Astro.url.pathname === home.replace(/\/$/, '');
const items = Object.entries(t.nav) as [string, string][];
const href = (id: string) => (isHome ? `#${id}` : `${home}#${id}`);
const switchTo = (l: Lang) => alternatePath(Astro.url.pathname, l);
---
<a
  href="#contenido"
  class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-malva focus:px-4 focus:py-2 focus:text-ink"
>{t.skip}</a>

<div class="fixed inset-x-0 top-3 z-50 flex justify-center px-3 sm:top-4">
  <nav
    class="relative w-full max-w-4xl rounded-[1.6rem] border border-paper/20 bg-ink/95 px-2 py-2 text-paper shadow-[0_10px_40px_-15px_rgb(0_0_0/0.5)] backdrop-blur"
    aria-label="Principal"
    data-nav
  >
    <div class="flex items-center justify-between gap-2">
      <a href={home} class="ml-1 inline-flex h-10 items-center justify-center rounded-lg border-[1.5px] border-dashed border-malva px-2.5 font-mono text-sm font-semibold tracking-wider text-malva transition-colors hover:bg-malva hover:text-ink" aria-label="Lourdes Ibañez">LI</a>
      <ul class="hidden items-center gap-1 md:flex">
        {items.map(([id, label]) => (
          <li>
            <a
              href={href(id)}
              data-nav-link={id}
              class="rounded-full px-4 py-2 text-sm text-paper/75 transition-colors duration-300 hover:text-malva data-[active]:bg-malva data-[active]:text-ink"
            >{label}</a>
          </li>
        ))}
      </ul>
      <div class="flex items-center gap-2">
        <div class="flex items-center rounded-full border border-paper/25 p-0.5 font-mono text-xs uppercase tracking-widest" role="group" aria-label={t.langLabel}>
          {(['es', 'en'] as Lang[]).map((l) =>
            l === lang ? (
              <span class="rounded-full bg-malva px-2.5 py-1.5 text-ink" aria-current="true">{l}</span>
            ) : (
              <a href={switchTo(l)} hreflang={l} lang={l} data-lang-switch class="rounded-full px-2.5 py-1.5 text-paper/75 transition-colors duration-300 hover:text-malva">
                <span class="sr-only">{l === 'en' ? 'English' : 'Español'}: </span>{l}
              </a>
            )
          )}
        </div>
        <button
          type="button"
          class="inline-flex size-10 items-center justify-center rounded-full border border-paper/30 transition-colors hover:border-malva hover:text-malva md:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-menu-toggle
        >
          <span class="sr-only">{t.menu}</span>
          <Icon name="menu" class="size-5" />
        </button>
      </div>
    </div>
    <ul id="mobile-menu" class="hidden flex-col gap-1 px-2 pb-2 pt-3 md:hidden" data-menu>
      {items.map(([id, label]) => (
        <li>
          <a href={href(id)} data-nav-link={id} class="block rounded-2xl px-4 py-3 font-display text-3xl font-bold uppercase transition-colors hover:bg-paper/10 data-[active]:text-malva">{label}</a>
        </li>
      ))}
    </ul>
  </nav>
</div>
