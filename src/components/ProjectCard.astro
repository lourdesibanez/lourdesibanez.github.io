---
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';
import { routes, useTranslations, type Lang } from '../i18n/ui';
interface Props { project: CollectionEntry<'projects'>; slug: string; n: number; lang: Lang }
const { project, slug, n, lang } = Astro.props;
const t = useTranslations(lang);
const d = project.data;
const href = routes.project(lang, slug);
const fitClass = {
  logo: 'object-contain p-8',
  phone: 'object-contain object-bottom px-6 pt-5',
  cover: 'object-cover object-top',
}[d.cover.fit];
const bg = d.cover.fit === 'cover' ? 'bg-ink' : d.cover.fit === 'phone' ? 'bg-blush' : 'bg-white';
---
<article class="reveal group flex flex-col" data-project data-categories={d.categories.join(' ')}>
  <a href={href} class="group/image relative block overflow-hidden rounded-xl border border-ink/10" aria-label={`${t.projects.details}: ${d.title}`}>
    <div class:list={['relative aspect-[16/10]', bg]}>
      <img src={d.cover.src} alt={d.cover.alt} loading="lazy" decoding="async" class:list={['absolute inset-0 size-full transition-transform duration-700 ease-out group-hover/image:scale-[1.05]', fitClass]} />
      <span class="absolute inset-0 bg-malva/0 transition-colors duration-300 group-hover/image:bg-malva/15"></span>
    </div>
    <span class="absolute bottom-3 right-3 flex size-9 items-center justify-center rounded-full bg-ink text-paper transition-all duration-300 group-hover/image:-rotate-12 group-hover/image:bg-malva group-hover/image:text-ink">
      <Icon name="arrow" class="size-4" />
    </span>
    <span class="absolute left-3 top-3 rounded-md bg-ink px-2 py-0.5 font-mono text-[0.68rem] text-paper">{String(n).padStart(2, '0')}</span>
  </a>
  <div class="mt-4 flex flex-1 flex-col">
    <p class="font-mono text-[0.66rem] uppercase tracking-[0.14em] text-malva-ink">{d.kicker}</p>
    <h3 class="mt-1.5 font-display text-[1.7rem] font-extrabold uppercase leading-[0.95] tracking-tight">
      <a href={href} class="transition-colors hover:text-malva-ink">{d.title}</a>
    </h3>
    <p class="mt-2 text-sm leading-relaxed text-ink/70">{d.cardSummary}</p>
    <ul class="mt-3 flex flex-wrap gap-1">
      {d.tags.map((tag) => <li class="rounded-md border border-ink/15 bg-paper px-2 py-0.5 font-mono text-[0.64rem] uppercase tracking-wider text-ink/75">{tag}</li>)}
    </ul>
    <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 pt-4 text-[0.82rem] font-medium">
      <a href={href} class="inline-flex items-center gap-1 border-b border-ink pb-0.5 hover:border-malva hover:text-malva-ink">{t.projects.details}<Icon name="arrow" class="size-3.5" /></a>
      {d.links.map((l) => (
        <a href={l.href} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-ink/60 transition-colors hover:text-ink">
          <Icon name={l.kind === 'external' ? 'external' : l.kind} class="size-3.5" />{l.label}
        </a>
      ))}
    </div>
  </div>
</article>
